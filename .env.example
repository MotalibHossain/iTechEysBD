<!-- ══ FLOATING PDF BUTTON ══ -->
<div class="fab-wrap">
  <button class="btn-pdf" onclick="window.print()">
    <span class="pdf-icon">⬇</span>
    Download <span class="gold-txt">PDF</span>
  </button>
</div>

</body>
