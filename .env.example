        <div class="field"><label>Current Address</label><value>8/9 Sukrabad, Dhanmondi-32<br>Dhaka, Bangladesh</value></div>
        <div class="field"><label>Grew Up In</label><value>Kalupara, Badarganj, Rangpur</value></div>
      </div>
    </div>

    <!-- Education -->
    <div class="section">
