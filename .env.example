<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="description" content="Marriage Biodata of Md. Motalib Hossain – Software Developer, Dhaka, Bangladesh"/>
<title>Marriage Biodata – Md. Motalib Hossain</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --green-dark:  #1a3a2a;
  --green-mid:   #2d5a3d;
  --green-light: #3a7a52;
  --gold:        #c9a84c;
  --gold-light:  #e8c97a;
  --text:        #1e1e1e;
  --text-soft:   #555;
  --border:      #e4ddd4;
  --bg-page:     #f4f0eb;
  --bg-card:     #fff;
}

html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', sans-serif;
  background: var(--bg-page);
  color: var(--text);
  min-height: 100vh;
  padding: 20px 12px 100px;
}

/* ── Page wrapper ── */
.page {
  max-width: 760px;
  margin: 0 auto;
  background: var(--bg-card);
  border-radius: 6px;
  overflow: hidden;
  box-shadow: 0 6px 36px rgba(0,0,0,0.11);
}

/* ════════════════════════════════
   HEADER
════════════════════════════════ */
.header {
  background: linear-gradient(150deg, var(--green-dark) 0%, var(--green-mid) 55%, var(--green-light) 100%);
  padding: 0 28px 28px;
  position: relative;
}
.header::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--gold), var(--gold-light), var(--gold));
}

.bismillah-bar {
  text-align: center;
  padding: 16px 0 13px;
  border-bottom: 1px solid rgba(201,168,76,0.22);
  margin-bottom: 22px;
}
.bismillah {
  font-size: clamp(15px, 4vw, 20px);
  color: var(--gold);
  letter-spacing: 1.5px;
  font-weight: 300;
  line-height: 1.6;
}

.header-row {
  display: flex;
  align-items: flex-start;
  gap: 22px;
}

.photo-wrap {
  flex-shrink: 0;
  width: 100px;
  height: 118px;
  border-radius: 6px;
  border: 2.5px solid var(--gold);
  overflow: hidden;
  background: rgba(255,255,255,0.08);
  display: flex; align-items: center; justify-content: center;
}
.photo-placeholder { font-size: 42px; opacity: 0.35; }

.header-text { flex: 1; min-width: 0; }

.name {
  font-family: 'Playfair Display', serif;
  font-size: clamp(22px, 5.5vw, 32px);
  color: #fff;
  line-height: 1.15;
  margin-bottom: 7px;
  word-break: break-word;
}
.badge {
  display: inline-block;
  background: rgba(201,168,76,0.18);
  border: 1px solid var(--gold);
  color: var(--gold-light);
  font-size: clamp(9px, 2.2vw, 11px);
  font-weight: 600;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  padding: 3px 11px;
  border-radius: 20px;
  margin-bottom: 13px;
}

.header-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 5px 14px;
}
.header-meta span {
  font-size: clamp(11px, 2.8vw, 13px);
  color: rgba(255,255,255,0.72);
  display: flex; align-items: center; gap: 4px;
  white-space: nowrap;
}
.header-meta span strong { color: var(--gold-light); font-weight: 500; }

/* ════════════════════════════════
   BODY
════════════════════════════════ */
.body { padding: 0 22px 32px; }

/* ── Section ── */
.section { margin-top: 26px; }

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(13px, 3.5vw, 15px);
  font-weight: 700;
  color: var(--green-dark);
  padding-bottom: 8px;
  border-bottom: 2px solid var(--green-mid);
  margin-bottom: 14px;
  display: flex; align-items: center; gap: 8px;
}
.section-title .icon {
  width: 22px; height: 22px;
  background: var(--green-mid);
  border-radius: 4px;
  display: flex; align-items: center; justify-content: center;
  color: var(--gold);
  font-size: 11px;
  flex-shrink: 0;
}

/* ── Grid ── */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px 20px;
}
@media (max-width: 480px) {
  .grid { grid-template-columns: 1fr; gap: 10px; }
}

.field { display: flex; flex-direction: column; gap: 2px; }
.field label {
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: #999;
}
.field value {
  font-size: clamp(13px, 3.2vw, 14px);
  color: var(--text);
  font-weight: 500;
  line-height: 1.5;
}
.field value em {
  font-style: normal;
  color: var(--green-mid);
}

/* ── Divider ── */
hr.divider {
  border: none;
  border-top: 1px dashed #e0d8cc;
  margin: 14px 0;
}

/* ── Quote block ── */
.quote-block {
  background: linear-gradient(135deg, #f9f6ef, #f4f0e8);
  border-left: 4px solid var(--gold);
  padding: 13px 16px;
  border-radius: 0 6px 6px 0;
  font-size: clamp(12px, 3vw, 13.5px);
  color: #3a3a3a;
  line-height: 1.75;
  font-style: italic;
}

/* ── Tags ── */
.tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.tag {
  background: #f0f7f3;
  border: 1px solid #b8d8c4;
  color: #1a5c33;
  font-size: clamp(11px, 2.5vw, 12px);
  padding: 3px 10px;
  border-radius: 20px;
  font-weight: 500;
}

/* ── Contact strip ── */
.contact-strip {
  background: linear-gradient(135deg, var(--green-dark), var(--green-mid));
  margin: 26px -22px -32px;
  padding: 20px 22px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px 28px;
  align-items: center;
  justify-content: center;
}
.contact-item { display: flex; flex-direction: column; align-items: center; }
.ci-label {
  font-size: 9.5px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--gold);
  font-weight: 600;
}
.ci-val {
  color: #fff;
  font-weight: 500;
  font-size: clamp(12px, 3vw, 13px);
}
.footer-note {
  width: 100%;
  text-align: center;
  font-size: 10.5px;
  color: rgba(255,255,255,0.35);
  margin-top: 8px;
}

/* ════════════════════════════════
   FLOATING DOWNLOAD BUTTON
════════════════════════════════ */
.fab-wrap {
  position: fixed;
  bottom: 24px;
  right: 20px;
  z-index: 999;
}
.btn-pdf {
  display: flex;
  align-items: center;
  gap: 9px;
  background: linear-gradient(135deg, var(--green-dark), var(--green-mid));
  color: #fff;
  border: none;
  padding: 13px 20px;
  border-radius: 50px;
  font-family: 'Inter', sans-serif;
  font-size: clamp(12px, 3.2vw, 14px);
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(26,58,42,0.45);
  transition: transform 0.15s, box-shadow 0.15s;
  white-space: nowrap;
}
.btn-pdf:hover  { transform: translateY(-2px); box-shadow: 0 8px 26px rgba(26,58,42,0.55); }
.btn-pdf:active { transform: scale(0.97); }
.btn-pdf .pdf-icon { font-size: 15px; }
.btn-pdf .gold-txt { color: var(--gold-light); }

/* ════════════════════════════════
   PRINT / PDF
════════════════════════════════ */
@media print {
  body { background: #fff; padding: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .page { box-shadow: none; border-radius: 0; max-width: 100%; }
  .fab-wrap { display: none !important; }
  .contact-strip { margin: 26px 0 0 !important; }
  .header { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}

/* ════════════════════════════════
   SMALL PHONE TWEAKS
════════════════════════════════ */
@media (max-width: 380px) {
  .header { padding: 0 16px 22px; }
  .body   { padding: 0 16px 28px; }
  .photo-wrap { width: 80px; height: 96px; }
  .contact-strip { margin: 26px -16px -28px; padding: 18px 16px; }
}
</style>
</head>
<body>

<div class="page">

  <!-- ══ HEADER ══ -->
  <div class="header">
    <div class="bismillah-bar">
      <div class="bismillah">بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيم</div>
    </div>
    <div class="header-row">
      <div class="photo-wrap">
        <span class="photo-placeholder">👤</span>
