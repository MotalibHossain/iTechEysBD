        <div class="field"><label>Diploma</label><value>Computer Technology<br><em>Rajshahi Polytechnic Institute, 2018</em></value></div>
        <div class="field"><label>SSC</label><value>Science<br><em>Kalupara Mahadipur High School, 2014</em></value></div>
      </div>
    </div>

    <!-- Profession -->
    <div class="section">
      <div class="section-title"><span class="icon">💼</span> Profession</div>
